      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=\"traefik-hub\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Hub access logs",
      "type": "logs"
    }
