# Copy to terraform.tfvars and fill in. The recording workstation for Demo Studio.
resource_group_name   = "solution-architecture"
location              = "eastus"
subnet_id             = "" # e.g. module.vnet.vm_subnet_id, or a real subnet resource id
admin_password        = "" # strong password — used for SSH + RDP + sudo
source_address_prefix = "" # YOUR operator IP/CIDR (e.g. 203.0.113.10/32) — do not leave as "*"

# Optional:
# vm_name          = "demo-desktop"
# git_deploy_key   = ""      # RW deploy key so `git pull/push` works from ~/traefik-demo
# source_image_id  = ""      # Phase B golden image; empty = vanilla Ubuntu + cloud-init
# dev_toolchain    = { bruno = false }   # override individual tools; unset = all true
