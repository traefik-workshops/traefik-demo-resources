# Terraform working files — modules here are consumed remotely, never applied in-repo,
# but contributors run `terraform init`/`validate` locally.
.terraform*
# ...but .terraform-docs.yml is checked-in tooling config, not a working file.
# Without this negation the `.terraform*` glob above silently swallows it, and the
# README sweep renders pinned provider versions instead of declared constraints.
!.terraform-docs.yml
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log

# Variable files (real values) — .example variants are allowed
*.tfvars
*.tfvars.json
*.auto.tfvars
!*.tfvars.example
!*.tfvars.json.example

# Packaged charts + pulled dependencies. The whole charts/ dir is build output: helm 4
# stopped resolving .tgz deps in place, so `helm dep update` is now followed by an
# unpack and the directory fills with subchart TREES, not just tarballs. Ignoring only
# *.tgz left every clone dirty after a lint — which in turn blocks `make release-*`.
helm/*/charts/
*.tgz

# Secrets — defense in depth
*.pem
*.key
*.p12
*.pfx
*.p8
credentials
credentials.json
service-account*.json

.DS_Store
